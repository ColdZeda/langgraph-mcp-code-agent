# =============================================================
# 环境变量配置模板
# 复制此文件为 .env 并填入真实值，.env 已被 .gitignore 排除
# =============================================================

# --- LLM API Key（必填）---
MODEL_API_KEY=请在此填入你的API密钥

# --- 模型配置（可选）---
# MODEL_NAME=deepseek-v4-flash
# MODEL_BASE_URL=https://api.deepseek.com

# --- SearXNG 私密搜索引擎（可选）---
# SEARXNG_URL=http://localhost:8888

# --- MySQL 沙盒数据库（可选）---
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3307
# MYSQL_USER=root
# MYSQL_PASSWORD=root
# MYSQL_DATABASE=agent_test
# MYSQL_READONLY_USER=agent_readonly
# MYSQL_READONLY_PASSWORD=readonly_pwd

# --- WSL2 虚拟机（可选）---
# CODE_AGENT_WSL_DISTRO=Ubuntu
# CODE_AGENT_VM_UPLOADS_DIR=/home/leprite/nginx/uploads

# --- 日志级别（可选，默认 INFO）---
# LOG_LEVEL=DEBUG
# 日志格式：1 = 单行 JSON（便于检索），不设 = 人类可读文本
# LOG_JSON=1

# --- 会话 ID（可选，默认 CLI 自动生成 UUID）---
# CODE_AGENT_THREAD_ID=
