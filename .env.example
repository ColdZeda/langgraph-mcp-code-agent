# =============================================================
# 环境变量配置模板
# 复制为 .env 并填真实值（.env 已被 .gitignore 排除）
#
# 谁需要它：只有 **CLI（main.py）与评估（evals/）** 需要。
#   Web 用户不用碰 —— 启动后在界面「⚙ 模型设置」里配即可
#   （存 runtime/web-settings.json，立即生效，可存多个模型）。
#   ⚠️ 反向也成立：界面里配的那把 key 帮不上 CLI / evals。
# 全部可选；不设就用等号右边的默认值。
# =============================================================

# --- LLM API Key（CLI / evals 必填；Web 用户在界面里配）---
#MODEL_API_KEY=请在此填入你的API密钥

# --- 模型 ---
# MODEL_NAME=deepseek-v4-flash                       # 不设 = 这个
# MODEL_BASE_URL=https://api.deepseek.com            # 任意 OpenAI 兼容接口
# CODE_AGENT_LLM_TIMEOUT=60                          # 单次调用超时（秒）；降级链在 config/models.json 里配
# LLM_STREAM_USAGE=1                                 # 流式响应里也取 usage；设 0 会让 token 计量偏少

# --- 会话与日志 ---
# CODE_AGENT_THREAD_ID=                              # 不设 = CLI 自动生成 UUID
# LOG_LEVEL=INFO
# LOG_JSON=1                                         # 1 = 单行 JSON（便于检索）；不设 = 人类可读

# --- SearXNG 私密搜索引擎 ---
# SEARXNG_URL=http://localhost:8888
# SEARXNG_DIR=                                       # compose 用的配置目录；不设 = 仓库内 ./searxng 空配置起（搜索可能不可用）

# --- MySQL 沙盒库 ---
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3307
# MYSQL_USER=root
# MYSQL_PASSWORD=root
# MYSQL_DATABASE=agent_test
# MYSQL_CHARSET=utf8mb4
# MYSQL_READONLY_USER=agent_readonly                 # 只读账号；**代码里没有默认值**
# MYSQL_READONLY_PASSWORD=readonly_pwd

# --- WSL2 虚拟机 ---
# CODE_AGENT_WSL_DISTRO=Ubuntu
# CODE_AGENT_VM_UPLOADS_DIR=/home/user/nginx/uploads
# CODE_AGENT_VM_TIMEOUT=60                           # 单条 WSL 命令超时（秒），防止卡死

# ============ 上下文工程与分层记忆（机制说明见 AGENTS.md / README.md）============
# CODE_AGENT_EXTERNALIZE_THRESHOLD=6000           # 长工具结果 ≥ 这个字符数就落盘 runtime/tool_results/
# CODE_AGENT_EXTERNALIZE_PREVIEW_CHARS=500        # 外置后上下文里留多少预览
# CODE_AGENT_EXTERNALIZE_MAX_LINES=150            # 行数兜底：字符没超但行数极多（长清单）也一样吃 token
# CODE_AGENT_EXTERNALIZE_EXEMPT=read_file_range,read_file   # 永不外置的工具（逗号分隔）—— 外置它们实测让 token 涨 7 倍
# CODE_AGENT_CONTEXT_WINDOW=128000                # 全局覆盖模型窗口；不设 = 注册表里的值，再不然 128000
# CODE_AGENT_COMPACT_THRESHOLD=32000              # 压实阈值（默认 = 窗口 25%）
# CODE_AGENT_COMPACT_KEEP=8                       # 压实后原样保留的最近消息条数
# CODE_AGENT_NODE_TOKEN_BUDGET=64000              # 节点级剪枝（默认 = 窗口 50%）；**不许超过窗口**
# CODE_AGENT_TASK_TOKEN_BUDGET=512000             # 任务级硬上限 / 成本保险丝（默认 = max(50 万, 4×窗口)）
# ⚠️ 上面四个阈值**一旦显式设置就完全按你写的来**（跑评估 `=0` 的口径靠的就是它）
#    例：128k 窗口 → 32000 / 64000 / 512000；1M 窗口 → 64000 / 200000 / 2000000
# CODE_AGENT_TASK_WALL_CLOCK=900                  # 任务级墙钟（秒）；0/负数 = 不限制；与界面「停止」同一条路径
# ⚠️ 权限弹框 / 人工确认期间不计时。默认 900（15 分钟）：正常任务实测 1~5 分钟，失控的实测 30 分钟 / 20.8 万 token
# CODE_AGENT_REDIS_URL=redis://127.0.0.1:6379/0   # 只读工具结果缓存；挂了自动降级为直连
# CODE_AGENT_TOOL_CACHE_TTL=600
# CODE_AGENT_TOOL_CACHE=1                         # 跑评估可设 0 关掉

# --- RAG 分层记忆 ---
# CODE_AGENT_RAG_COLLECTION=terminal_knowledge_v2   # 换名：旧的「整篇一个向量」与新的「每块一个向量」不能混用
# CODE_AGENT_RAG_CHUNK_MAX_CHARS=500                # 单块最大字符数（超长才切开）
# CODE_AGENT_RAG_CHUNK_OVERLAP=0.15
# CODE_AGENT_RAG_RECALL_K=10                        # 向量粗召回条数 → CrossEncoder 精排 → 取 top-K
# CODE_AGENT_RAG_TOP_K=3
# CODE_AGENT_RAG_AUTO_INJECT=1                      # 任务开始时自动检索一次相关知识并注入（寒暄 / 过短输入不查）
# CODE_AGENT_RAG_AUTO_DEPOSIT=1                     # ⚠️ 跑评估**必须设 0**，否则评测经验会改写知识库
# 两个本地模型（各 ≈87MB，**都不进版本控制**；装法 `uv run python scripts/fetch_models.py`）：
# CODE_AGENT_EMBEDDING_MODEL_PATH=../embedding-model/sentence-transformers/all-MiniLM-L6-v2
#                                                   # ↑ 向量模型 **必需**：缺了 RAG 那 4 个工具会立刻报错并提示怎么装
# CODE_AGENT_EMBEDDING_MODEL_CACHE_DIR=../embedding-model    # 下载 / 存放目录
# CODE_AGENT_RERANKER_PATH=../embedding-model/cross-encoder/ms-marco-MiniLM-L-6-v2
#                                                   # ↑ 精排模型 **可选**：不存在则降级纯向量召回（不联网下载）
# CODE_AGENT_RERANK=1
# 下面两个是 **huggingface_hub 读的，不是本项目读的**；fetch_models.py 默认就走 hf-mirror ⇒ 一般不用设
# HF_ENDPOINT=https://hf-mirror.com
# HF_HOME=../embedding-model

# --- 三档权限（档位表见 app/code_agent/security/permissions.py）---
# CODE_AGENT_PERMISSION_MODE=confirm      # readonly / confirm / open；「放开」永不持久化，新会话一律回落 confirm
# CODE_AGENT_CONFIRM_TIMEOUT=120          # 人工确认超时（秒）：超时 / 无人应答 → **自动拒绝**（只作用于 Web）
# CODE_AGENT_PERMISSIONS_LOG=runtime/permissions.log   # 审计：高危操作 + 所有确认决定，一行一条 JSON

# --- 评估（evals/）---
# EVAL_TASK_TIMEOUT=                      # 整轮墙钟**覆盖值**（秒）；0/负数 = 不设超时、只计量；不设 = 用每题自己的 timeout_sec
# CODE_AGENT_RUNTIME_DIR=runtime          # 评估那份工作副本 / 向量库的根

# --- 路径覆盖（高级；不设全在仓库内，一般不用改）---
# CODE_AGENT_KNOWLEDGE_DIR=data/knowledge           # 产品知识库目录
# CODE_AGENT_WORKSPACE_DIR=runtime/workspace        # 7 个文件工具的活动根
# CODE_AGENT_CHECKPOINT_DB=runtime/checkpoints.db   # 跨轮记忆的 SQLite
# CODE_AGENT_SESSIONS_DB=runtime/sessions.db        # 会话侧车库（标题 / 置顶 / 软删除）
# CODE_AGENT_CHROMA_DIR=runtime/chroma_db           # 向量库
# CODE_AGENT_RUNS_DIR=runtime/runs                  # 运行产物（报告 / 基准快照）
# CODE_AGENT_TOOL_RESULTS_DIR=runtime/tool_results  # 外置的长工具结果落盘处
# CODE_AGENT_PYTHON=                                # MCP server / 子进程用哪个解释器；不设 = 当前解释器

# --- Web（一般不用手动设；启动脚本会自己设）---
# CODE_AGENT_WEB_URL=                    # 设了才会在「已就绪」横幅里打印可点击的 URL
