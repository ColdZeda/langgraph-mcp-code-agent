# =============================================================
# 环境变量配置模板
# 复制此文件为 .env 并填入真实值，.env 已被 .gitignore 排除
# =============================================================

# --- 两种配置方式，选一种就够了 ---
# ① 直接在这里填；② 或者启动后在 Web 界面的「⚙ 模型设置」里加自己的模型（界面里配的优先，改这里要重启）

# --- LLM API Key（必填）---
MODEL_API_KEY=请在此填入你的API密钥

# --- 模型配置（可选）---
# MODEL_NAME=deepseek-v4-flash
# MODEL_BASE_URL=https://api.deepseek.com

# --- SearXNG 私密搜索引擎（可选）---
# SEARXNG_URL=http://localhost:8888

# --- MySQL 沙盒数据库（可选）---
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3307
# MYSQL_USER=root
# MYSQL_PASSWORD=root
# MYSQL_DATABASE=agent_test
# MYSQL_READONLY_USER=agent_readonly
# MYSQL_READONLY_PASSWORD=readonly_pwd

# --- WSL2 虚拟机（可选）---
# CODE_AGENT_WSL_DISTRO=Ubuntu
# CODE_AGENT_VM_UPLOADS_DIR=/home/user/nginx/uploads

# --- LLM 超时（可选，默认 60 秒）---
# 管的是「模型太慢/挂起」；模型报错的降级链在 config/models.json 里配
# CODE_AGENT_LLM_TIMEOUT=60

# --- 日志级别（可选，默认 INFO）---
# LOG_LEVEL=DEBUG
# 日志格式：1 = 单行 JSON（便于检索），不设 = 人类可读文本
# LOG_JSON=1

# --- 会话 ID（可选，默认 CLI 自动生成 UUID）---
# CODE_AGENT_THREAD_ID=

# =============================================================
# 阶段 4 · 上下文工程与分层记忆（全部可选，不设就用下面的默认值）
# =============================================================

# --- 工具结果外置（T4.1）---
# 超过阈值的长工具结果落盘到 runtime/tool_results/，上下文里只留预览 + 路径。
# 阈值 6000 是按实测校准的（第六版建议的 2000 会把 71 行的文件读取也外置，不划算）。
# CODE_AGENT_EXTERNALIZE_THRESHOLD=6000
# CODE_AGENT_EXTERNALIZE_PREVIEW_CHARS=500
# 行数兜底：字符数没超但行数极多（长清单）也一样吃 token
# CODE_AGENT_EXTERNALIZE_MAX_LINES=150

# --- token 预算 / 压实（阶段 4；**阶段 8 · P2 起默认按模型窗口自动算**）---
# 默认不再是三个写死的数，而是按「当前 executor 实际用的模型」的上下文窗口算：
#   压实 25% · 单次调用输入 50% · 任务累计 max(50 万, 4×窗口)（并各有上下限封顶）。
#   例：128k 窗口 → 32000 / 64000 / 512000；1M 窗口 → 64000 / 200000 / 2000000。
#   ⚠️ 顺序约束：压实必须**明显小于**单次输入（前者用摘要换掉老历史、信息还在；后者超限是**直接砍掉**）。
#   ⚠️ 上限是理智闸门：真用 >500k 窗口的模型时，要**连上限一起抬**，否则会被卡回 64k / 200k。
# 模型窗口从哪来（优先级高→低）：
#   ① 下面这个 CODE_AGENT_CONTEXT_WINDOW（全局覆盖，任何模型都用它）
#   ② 注册表里该模型的 context_window 字段（config/models.json，或 Web 面板「我的模型」里填的）
#   ③ 128000（默认）
# CODE_AGENT_CONTEXT_WINDOW=128000
#
# ⚠️ **下面三个一旦显式设置，就完全按你写的来**（优先级最高 —— 评估口径 `=0` 也靠它）：
# 压实：历史估算 token 超过它 → 把最老的一段压成「目标/约束/已完成/未决」四段式摘要
# CODE_AGENT_COMPACT_THRESHOLD=32000
# 压实后原样保留的最近消息条数
# CODE_AGENT_COMPACT_KEEP=8
# 节点级：进模型前估算 prompt，超了先剪枝（砍最老的工具结果）
#    ⚠️ **不能超过模型窗口**（token 是估算值 ⇒ 留 20% 余量）
# CODE_AGENT_NODE_TOKEN_BUDGET=64000
# 任务级硬上限：单任务累计 token 超了 → 主动终止并报告，而不是烧到失控
#    ⚠️ 它是**成本保险丝**，不是"窗口的一个小比例"：长任务本来就要跑好几轮满上下文
# CODE_AGENT_TASK_TOKEN_BUDGET=512000

# --- 任务级墙钟（阶段 8 · P0）---
# 单个任务最长**执行**时间（秒）；到点自动停 —— 与界面上的「停止」走同一条路径。
# ⚠️ 权限弹框 / 人工确认**期间不计时**（人看弹框的时间不是任务时间）。
#    默认 900（15 分钟）：正常任务实测 1~5 分钟；失控任务实测 30 分钟 / 20.8 万 token。
#    0 或负数 = 不限制（只有点「停止」能停）。
# CODE_AGENT_TASK_WALL_CLOCK=900

# --- Redis 工具结果缓存（T4.5）---
# 只缓存**只读**工具；写操作绝不缓存，且写之后会清空本会话缓存。
# Redis 挂了会自动降级为直连执行（不报错）。评估时可设 0 关掉。
# CODE_AGENT_REDIS_URL=redis://127.0.0.1:6379/0
# CODE_AGENT_TOOL_CACHE_TTL=600
# CODE_AGENT_TOOL_CACHE=1

# --- RAG 分层记忆（T4.4）---
# 换 collection 名：旧的「整篇一个向量」和新「每块一个向量」不能混在一起
# CODE_AGENT_RAG_COLLECTION=terminal_knowledge_v2
# 单块最大字符数（超长才切开；知识库里的短条目天然各成一块）
# CODE_AGENT_RAG_CHUNK_MAX_CHARS=500
# CODE_AGENT_RAG_CHUNK_OVERLAP=0.15
# 向量粗召回条数 → CrossEncoder 精排 → 取 top-K
# CODE_AGENT_RAG_RECALL_K=10
# CODE_AGENT_RAG_TOP_K=3
# ── RAG 的两个本地模型（**都不进版本控制**，用脚本装）────────────────────────
# 为什么单独列出来：别人 clone 下来时这两个模型**不在仓库里**（各 ≈87MB）。
#   装：uv run python scripts/fetch_models.py        （默认下到 <仓库上级目录>/embedding-model，走 hf-mirror）
#   查：uv run python scripts/fetch_models.py --dry-run
#
# 向量模型：**必需**（缺了 RAG 那 4 个工具会立刻报错并提示怎么装；其余工具不受影响）
# CODE_AGENT_EMBEDDING_MODEL_PATH=../embedding-model/sentence-transformers/all-MiniLM-L6-v2
# 下载缓存目录（手工放模型时用不到；fetch_models.py --target 指的就是它）
# CODE_AGENT_EMBEDDING_MODEL_CACHE_DIR=../embedding-model
#
# 精排模型：**可选**；不存在则降级为纯向量召回（不联网下载）
# CODE_AGENT_RERANKER_PATH=../embedding-model/cross-encoder/ms-marco-MiniLM-L-6-v2
# CODE_AGENT_RERANK=1
# 任务开始时自动检索一次相关知识并注入（寒暄/过短输入不查）
# CODE_AGENT_RAG_AUTO_INJECT=1
# 任务成功后由模型判断要不要把经验写进知识库
# ⚠️ 跑评估时必须设 0，否则评测经验会改写知识库、让后续题目不可比
# CODE_AGENT_RAG_AUTO_DEPOSIT=1

# --- 三档权限模式（阶段 5 · T5.1）---
# 只读 / 需确认（默认）/ 放开；档位表见 app/code_agent/security/permissions.py。
# 这里只是「没有任何显式设置时」的兜底值：
#   · CLI 默认走它（需确认）；
#   · Web 端把「只读 / 需确认」持久化到 runtime/web-settings.json，
#     **「放开」永不持久化**（新会话一律回落「需确认」）；
#   · 评估等无人值守入口必须显式指定档位（否则「需确认」没人可问 → 全部自动拒绝）。
# CODE_AGENT_PERMISSION_MODE=confirm

# 人工确认超时（秒）：超时 / 无人应答 → **自动拒绝**（安全侧）。只作用于 Web。
# CODE_AGENT_CONFIRM_TIMEOUT=120

# 审计留痕（高危操作 + 所有确认决定，一行一条 JSON，追加式；在 runtime/ 下、已被 gitignore）
# CODE_AGENT_PERMISSIONS_LOG=runtime/permissions.log

# --- SearXNG 的配置/缓存目录（阶段 7 收尾时从 docker-compose 里挪出来的）---
# 为什么：`docker-compose.yml` 是**进仓库**的，里面不该写任何人的本机绝对路径。
# 现在 compose 里写的是 `${SEARXNG_DIR:-./searxng}` —— 默认落在仓库内的 ./searxng/。
# 本机（以及任何想复用已有配置的人）在 **.env** 里指过去即可，例如：
#   SEARXNG_DIR=E:/work/searXNG          （Windows 写法，注意用正斜杠）
#   SEARXNG_DIR=/home/me/searxng         （WSL / Linux 写法）
# 不设置也能跑：searxng 会用空配置起（搜索可能不可用）。
